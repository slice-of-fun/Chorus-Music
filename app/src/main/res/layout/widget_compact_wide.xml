<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:background="@drawable/widget_pill_bg"
    android:paddingStart="8dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical"
>

    <!-- Album Art - Circular -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_art_circle_bg"
>
        
        <ImageView
            android:id="@+id/widget_wide_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/music_note"
            android:contentDescription="@string/album_art" />
    </FrameLayout>

    <!-- Song Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_wide_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_playing"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_on_primary_container"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_wide_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_play"
            android:textSize="13sp"
            android:textColor="@color/widget_on_primary_container"
android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Play Button (Minimalist Icon) -->
    <ImageView
        android:id="@+id/widget_wide_play_pause"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="4dp"
        android:src="@drawable/ic_widget_play_low"
        android:contentDescription="@string/play_pause" />

</LinearLayout>
